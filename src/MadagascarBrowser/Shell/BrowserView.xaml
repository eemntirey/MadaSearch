<UserControl x:Class="MadagascarBrowser.Shell.BrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barre de commande unifiée : navigation + omnibox + menu -->
        <Border x:Name="Toolbar" Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <!-- Page en plein écran : la barre d'outils s'efface. -->
                        <DataTrigger Binding="{Binding IsFullScreen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="2"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Navigation -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,4,0">
                        <Button x:Name="BackBtn" Style="{StaticResource IconButton}"
                                Content="&#xE72B;" ToolTip="Retour" Click="Back_Click"
                                AutomationProperties.Name="Retour"/>
                        <Button x:Name="ForwardBtn" Style="{StaticResource IconButton}"
                                Content="&#xE72A;" ToolTip="Suivant" Click="Forward_Click"
                                AutomationProperties.Name="Suivant"/>
                        <Button x:Name="ReloadBtn" Style="{StaticResource IconButton}"
                                Content="&#xE72C;" ToolTip="Rafraîchir" Click="Reload_Click"
                                AutomationProperties.Name="Rafraîchir"/>
                    </StackPanel>

                    <!-- Pilule omnibox : état de sécurité + champ + favori -->
                    <Border Grid.Column="1" Margin="8,0" MaxWidth="820" HorizontalAlignment="Stretch"
                            Height="36" Background="{DynamicResource BgBrush}"
                            BorderBrush="{DynamicResource EdgeStrongBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusPill}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Slot d'état : globe / cadenas / avertissement.
                                 Le Core fournit le glyphe, le libellé et la clé du jeton
                                 de couleur (SecurityIndicatorResolver) : l'interface ne
                                 fait qu'appliquer la couleur. -->
                            <TextBlock x:Name="SecurityIndicatorText" Grid.Column="0"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13" VerticalAlignment="Center" Margin="12,0,6,0"
                                       Text="{Binding SecurityGlyph}"
                                       ToolTip="{Binding SecurityLabel}"
                                       AutomationProperties.Name="{Binding SecurityLabel}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SecurityBrushKey}" Value="SecureBrush">
                                                <Setter Property="Foreground" Value="{DynamicResource SecureBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SecurityBrushKey}" Value="WarnBrush">
                                                <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SecurityBrushKey}" Value="DangerBrush">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="AddressBar" Grid.Column="1"
                                     KeyDown="AddressBar_KeyDown" TextChanged="AddressBar_TextChanged"
                                     Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                     CaretBrush="{DynamicResource TextBrush}" BorderThickness="0"
                                     VerticalContentAlignment="Center" FontSize="13"
                                     SelectionBrush="{DynamicResource AccentBrush}"
                                     AutomationProperties.Name="Adresse"/>
                            <Button Grid.Column="2" Style="{StaticResource IconButtonSmall}" Content="&#xE734;"
                                    Margin="4" ToolTip="Ajouter aux favoris" Click="MenuAddFavorite_Click"
                                    AutomationProperties.Name="Ajouter aux favoris"/>
                        </Grid>
                    </Border>

                    <!-- Menu -->
                    <Button x:Name="MenuBtn" Grid.Column="2" Style="{StaticResource IconButton}"
                            Content="&#xE712;" ToolTip="Menu" Click="Menu_Click"
                            AutomationProperties.Name="Menu"/>
                </Grid>

                <!-- Progression de chargement : filet 2 px sous la pilule -->
                <ProgressBar x:Name="LoadBar" Grid.Row="1" Height="2" IsIndeterminate="True"
                             Background="Transparent" Foreground="{DynamicResource AccentBrush}"
                             BorderThickness="0">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <!-- Suggestions d'historique -->
                <Popup x:Name="SuggestPopup" PlacementTarget="{Binding ElementName=AddressBar}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                       VerticalOffset="6">
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1"
                            CornerRadius="10" MinWidth="420" Margin="0,4,0,0">
                        <ListBox x:Name="SuggestList" MaxHeight="260"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextBrush}"
                                 ItemContainerStyle="{StaticResource DarkListItem}"
                                 PreviewMouseLeftButtonUp="SuggestList_Click"
                                 Margin="4">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="12.5"/>
                                        <TextBlock Text="{Binding Url}" FontSize="10.5"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>

                <!-- Menu contextuel -->
                <Popup x:Name="MenuPopup" PlacementTarget="{Binding ElementName=MenuBtn}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                       VerticalOffset="6" HorizontalOffset="-200">
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1"
                            CornerRadius="10" MinWidth="220" Padding="4">
                        <StackPanel>
                            <Button Style="{StaticResource MenuRowButton}" Click="MenuNewTab_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Nouvel onglet" FontSize="12.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MenuRowButton}" Click="MenuSettings_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Paramètres" FontSize="12.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MenuRowButton}" Click="MenuAddFavorite_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Ajouter aux favoris" FontSize="12.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MenuRowButton}" Click="MenuSaveOffline_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Enregistrer hors ligne" FontSize="12.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MenuRowButton}" Click="MenuOfflinePages_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Pages hors ligne" FontSize="12.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MenuRowButton}" Click="MenuHistory_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Historique" FontSize="12.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MenuRowButton}" Click="MenuFavorites_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Favoris" FontSize="12.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MenuRowButton}" Click="MenuDownloads_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Téléchargements" FontSize="12.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Separator Background="{DynamicResource EdgeBrush}" Margin="6,4"/>
                            <Button Style="{StaticResource MenuRowButton}" Click="MenuExportProfile_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Exporter le profil" FontSize="12.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MenuRowButton}" Click="MenuImportProfile_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Importer le profil" FontSize="12.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="MenuFeedback" Text="" FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}"
                                       Margin="10,2,10,6" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <wv2:WebView2 x:Name="WebView" Grid.Row="1"/>
        <StackPanel x:Name="WebViewError" Grid.Row="1" Visibility="Collapsed" Margin="24" VerticalAlignment="Center">
            <TextBlock x:Name="WebViewErrorText"
                       Text="WebView2 est indisponible sur cette machine."
                       Foreground="{DynamicResource TextBrush}" FontSize="16"/>
            <TextBlock Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap">
                <Run Text="Installez le WebView2 Runtime : "/>
                <Hyperlink NavigateUri="https://developer.microsoft.com/fr-fr/microsoft-edge/webview2/"
                           Foreground="{DynamicResource AccentBrush}"
                           RequestNavigate="WebView2Link_RequestNavigate">téléchargement officiel</Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
