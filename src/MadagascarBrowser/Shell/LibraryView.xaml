<UserControl x:Class="MadagascarBrowser.Shell.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Bibliothèque" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14"/>

        <TabControl x:Name="LibraryTabs" Grid.Row="1" SelectionChanged="LibraryTabs_SelectionChanged">
            <TabItem Header="Historique">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="HistorySearch" Height="32" Margin="0,0,0,8"
                             VerticalContentAlignment="Center" Padding="8,0"
                             ToolTip="Rechercher dans l'historique" TextChanged="HistorySearch_TextChanged"/>
                    <ListBox x:Name="HistoryList" Grid.Row="1" ItemContainerStyle="{StaticResource DarkListItem}"
                             MouseDoubleClick="OpenSelected_Click">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Url}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
            <TabItem Header="Favoris">
                <ListBox x:Name="FavoritesList" Margin="10" ItemContainerStyle="{StaticResource DarkListItem}"
                         MouseDoubleClick="OpenSelected_Click">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Url}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
            <TabItem Header="Hors ligne">
                <ListBox x:Name="OfflinePagesList" Margin="10" ItemContainerStyle="{StaticResource DarkListItem}"
                         MouseDoubleClick="OpenSelected_Click">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Url}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
            <Button Content="Ouvrir" MinWidth="88" Padding="12,7" Margin="0,0,8,0"
                    Click="OpenSelected_Click"/>
            <Button Content="Supprimer" MinWidth="88" Padding="12,7" Margin="0,0,8,0"
                    Click="RemoveSelected_Click"/>
            <Button x:Name="ClearHistoryButton" Content="Effacer l'historique" Padding="12,7"
                    Click="ClearHistory_Click"/>
        </DockPanel>
    </Grid>
</UserControl>
