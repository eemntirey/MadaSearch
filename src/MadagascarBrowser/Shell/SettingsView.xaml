<UserControl x:Class="MadagascarBrowser.Shell.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel>
            <TextBlock Text="Paramètres" Style="{StaticResource ViewTitle}"/>
            <TextBlock Text="Réglages du navigateur Madagascar Browser" Style="{StaticResource ViewSubtitle}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Colonne gauche : navigation et blocage -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Navigation" Style="{StaticResource SectionLabel}"/>
                <TextBlock Text="Moteur utilisé par la barre d'adresse." Style="{StaticResource ViewSubtitle}" Margin="0,4,0,8"/>
                <ComboBox x:Name="SearchProviderCombo" SelectedValuePath="Tag" Style="{StaticResource DarkComboBox}">
                    <ComboBoxItem Content="Google Madagascar" Tag="google"/>
                    <ComboBoxItem Content="DuckDuckGo" Tag="duckduckgo"/>
                    <ComboBoxItem Content="Bing" Tag="bing"/>
                </ComboBox>

                <TextBlock Text="Données et vie privée" Style="{StaticResource SectionLabel}" Margin="0,24,0,10"/>
                <CheckBox x:Name="AdBlockCheck" Content="Bloquer les publicités"
                          Style="{StaticResource DarkCheckBox}" Margin="0,0,0,12"/>
                <CheckBox x:Name="DataSaverCheck" Content="Économiser les données (images et vidéos)"
                          Style="{StaticResource DarkCheckBox}" Margin="0,0,0,12"/>
                <CheckBox x:Name="RestoreSessionCheck" Content="Restaurer les onglets au démarrage"
                          Style="{StaticResource DarkCheckBox}"/>
            </StackPanel>

            <!-- Colonne droite : domaines autorisés -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="Domaines autorisés" Style="{StaticResource SectionLabel}"/>
                <TextBlock Text="Ces domaines ne sont pas bloqués par le bloqueur de publicités."
                           Style="{StaticResource ViewSubtitle}" Margin="0,4,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="AllowedDomainBox" Grid.Column="0" Style="{StaticResource DarkTextBox}"
                             ToolTip="Domaine à autoriser, par exemple exemple.mg"/>
                    <Button Grid.Column="1" Content="Autoriser" Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" Click="AllowDomain_Click"/>
                </Grid>

                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource EdgeBrush}"
                        BorderThickness="1" CornerRadius="10" Margin="0,12,0,0" MinHeight="120">
                    <ListBox x:Name="AllowedDomainsList" Style="{StaticResource DarkListBox}"
                             ItemContainerStyle="{StaticResource DarkListItem}" MaxHeight="200" Margin="6">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding}" FontSize="12.5"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="1" Style="{StaticResource IconButtonSmall}"
                                            Content="&#xE711;" Margin="8,0,0,0"
                                            Click="RemoveDomain_Click" ToolTip="Retirer ce domaine"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <TextBlock x:Name="AllowedDomainsFeedback" FontSize="11.5"
                           Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- Barre d'actions -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
            <Grid>
                <TextBlock Text="Les modifications sont appliquées immédiatement."
                           Foreground="{DynamicResource MutedBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Annuler" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Click="Cancel_Click"/>
                    <Button Content="Enregistrer" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
