<UserControl x:Class="MadagascarBrowser.Shell.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Paramètres" FontSize="20" FontWeight="SemiBold"/>

        <StackPanel Grid.Row="1" Margin="0,20,0,20">
            <TextBlock Text="Moteur de recherche" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
            <ComboBox x:Name="SearchProviderCombo" SelectedValuePath="Tag" Height="32">
                <ComboBoxItem Content="Google Madagascar" Tag="google"/>
                <ComboBoxItem Content="DuckDuckGo" Tag="duckduckgo"/>
                <ComboBoxItem Content="Bing" Tag="bing"/>
            </ComboBox>
            <CheckBox x:Name="AdBlockCheck" Content="Bloquer les publicités" Margin="0,18,0,0"/>
            <CheckBox x:Name="DataSaverCheck" Content="Économiser les données (images et vidéos)" Margin="0,12,0,0"/>
            <CheckBox x:Name="RestoreSessionCheck" Content="Restaurer les onglets au démarrage" Margin="0,12,0,0"/>

            <TextBlock Text="Domaines autorisés" Foreground="{StaticResource MutedBrush}" Margin="0,20,0,6"/>
            <TextBlock Text="Ces domaines ne sont pas bloqués par le bloqueur de publicités."
                       Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="AllowedDomainBox" Grid.Column="0" Height="30"
                         VerticalContentAlignment="Center" Padding="8,0"/>
                <Button Grid.Column="1" Content="Autoriser" Margin="8,0,0,0"
                        Padding="14,6" Click="AllowDomain_Click"/>
            </Grid>
            <ListBox x:Name="AllowedDomainsList" Margin="0,10,0,0" MaxHeight="120"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource TextBrush}"
                     ItemContainerStyle="{StaticResource DarkListItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Style="{StaticResource IconButtonSmall}"
                                    Content="&#xE711;" Margin="8,0,0,0"
                                    Click="RemoveDomain_Click"
                                    ToolTip="Retirer ce domaine"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="AllowedDomainsFeedback" FontSize="11"
                       Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuler" MinWidth="88" Padding="12,7" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Enregistrer" MinWidth="100" Padding="12,7" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
