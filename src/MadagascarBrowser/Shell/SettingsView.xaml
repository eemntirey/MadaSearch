<UserControl x:Class="MadagascarBrowser.Shell.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="{DynamicResource ViewPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel>
            <TextBlock Text="Paramètres" Style="{StaticResource ViewTitle}"/>
            <TextBlock Text="Réglages du navigateur Madagascar Browser" Style="{StaticResource ViewSubtitle}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Cartes de réglages -->
        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- Navigation -->
                <Border Background="{DynamicResource SurfaceHighBrush}"
                        BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusCard}"
                        Padding="{DynamicResource CardPadding}"
                        Margin="{DynamicResource CardMargin}">
                    <StackPanel>
                        <TextBlock Text="Navigation" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="Moteur utilisé par la barre d'adresse." Style="{StaticResource ViewSubtitle}" Margin="0,4,0,10"/>
                        <ComboBox x:Name="SearchProviderCombo" SelectedValuePath="Tag" Style="{StaticResource DarkComboBox}"
                                  MaxWidth="320" HorizontalAlignment="Left">
                            <ComboBoxItem Content="Google Madagascar" Tag="google"/>
                            <ComboBoxItem Content="DuckDuckGo" Tag="duckduckgo"/>
                            <ComboBoxItem Content="Bing" Tag="bing"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Confidentialité -->
                <Border Background="{DynamicResource SurfaceHighBrush}"
                        BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusCard}"
                        Padding="{DynamicResource CardPadding}"
                        Margin="{DynamicResource CardMargin}">
                    <StackPanel>
                        <TextBlock Text="Données et vie privée" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="Le bloqueur de publicités et l'économiseur de données agissent sur chaque page."
                                   Style="{StaticResource ViewSubtitle}" Margin="0,4,0,12"/>
                        <CheckBox x:Name="AdBlockCheck" Content="Bloquer les publicités"
                                  Style="{StaticResource DarkCheckBox}" Margin="0,0,0,10"/>
                        <CheckBox x:Name="DataSaverCheck" Content="Économiser les données (images et vidéos)"
                                  Style="{StaticResource DarkCheckBox}" Margin="0,0,0,10"/>
                        <CheckBox x:Name="RestoreSessionCheck" Content="Restaurer les onglets au démarrage"
                                  Style="{StaticResource DarkCheckBox}"/>
                    </StackPanel>
                </Border>

                <!-- Effacement sélectif avec confirmation explicite -->
                <Border Background="{DynamicResource SurfaceHighBrush}"
                        BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusCard}"
                        Padding="{DynamicResource CardPadding}"
                        Margin="{DynamicResource CardMargin}">
                    <StackPanel>
                        <TextBlock Text="Effacer les données de navigation" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="Choisissez uniquement les catégories à supprimer. Les favoris, les téléchargements et les paramètres seront conservés."
                                   Style="{StaticResource ViewSubtitle}" Margin="0,4,0,10" TextWrapping="Wrap"/>
                        <CheckBox x:Name="ClearHistoryCheck" Content="Historique de navigation"
                                  Style="{StaticResource DarkCheckBox}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ClearCookiesCheck" Content="Cookies et données de session des sites"
                                  Style="{StaticResource DarkCheckBox}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ClearCacheCheck" Content="Cache WebView2"
                                  Style="{StaticResource DarkCheckBox}" Margin="0,0,0,10"/>
                        <Button Content="Effacer les données sélectionnées" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left" Click="ClearData_Click"/>
                        <TextBlock x:Name="ClearDataFeedback" FontSize="11.5"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Domaines autorisés -->
                <Border Background="{DynamicResource SurfaceHighBrush}"
                        BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusCard}"
                        Padding="{DynamicResource CardPadding}"
                        Margin="{DynamicResource CardMargin}">
                    <StackPanel>
                        <TextBlock Text="Domaines autorisés" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="Ces domaines ne sont pas bloqués par le bloqueur de publicités."
                                   Style="{StaticResource ViewSubtitle}" Margin="0,4,0,10"/>

                        <Grid MaxWidth="560" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AllowedDomainBox" Grid.Column="0" Style="{StaticResource DarkTextBox}"
                                     ToolTip="Domaine à autoriser, par exemple exemple.mg"/>
                            <Button Grid.Column="1" Content="Autoriser" Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0" Click="AllowDomain_Click"/>
                        </Grid>

                        <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource EdgeBrush}"
                                BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}" Margin="0,12,0,0" MinHeight="110">
                            <ListBox x:Name="AllowedDomainsList" Style="{StaticResource DarkListBox}"
                                     ItemContainerStyle="{StaticResource DarkListItem}" MaxHeight="180" Margin="6">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding}" FontSize="12.5"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="1" Style="{StaticResource IconButtonSmall}"
                                                    Content="&#xE711;" Margin="8,0,0,0"
                                                    Click="RemoveDomain_Click" ToolTip="Retirer ce domaine"
                                                    AutomationProperties.Name="Retirer ce domaine"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <TextBlock x:Name="AllowedDomainsFeedback" FontSize="11.5"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Apparence -->
                <Border Background="{DynamicResource SurfaceHighBrush}"
                        BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusCard}"
                        Padding="{DynamicResource CardPadding}"
                        Margin="{DynamicResource CardMargin}">
                    <StackPanel>
                        <TextBlock Text="Apparence" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="Thème, densité et couleur d'accent de l'interface."
                                   Style="{StaticResource ViewSubtitle}" Margin="0,4,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Thème" Style="{StaticResource ViewSubtitle}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="ThemeCombo" SelectedValuePath="Tag" Style="{StaticResource DarkComboBox}">
                                    <ComboBoxItem Content="Sombre" Tag="dark"/>
                                </ComboBox>
                                <TextBlock Text="Le mode clair n'est pas encore disponible."
                                           Style="{StaticResource ViewSubtitle}" FontSize="11" Margin="0,6,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="Densité" Style="{StaticResource ViewSubtitle}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="DensityCombo" SelectedValuePath="Tag" Style="{StaticResource DarkComboBox}"
                                          SelectionChanged="DensityCombo_SelectionChanged">
                                    <ComboBoxItem Content="Confortable" Tag="comfortable"/>
                                    <ComboBoxItem Content="Compacte" Tag="compact"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Accent" Style="{StaticResource ViewSubtitle}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="AccentCombo" SelectedValuePath="Tag" Style="{StaticResource DarkComboBox}"
                                          SelectionChanged="AccentCombo_SelectionChanged">
                                    <ComboBoxItem Content="Rouge malgache" Tag="malagasy"/>
                                    <ComboBoxItem Content="Vert" Tag="vert"/>
                                    <ComboBoxItem Content="Orange" Tag="orange"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Barre d'actions -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
            <Grid>
                <TextBlock Text="Les modifications sont appliquées immédiatement."
                           Foreground="{DynamicResource MutedBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Annuler" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Click="Cancel_Click"/>
                    <Button Content="Enregistrer" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
