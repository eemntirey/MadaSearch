<UserControl x:Class="MadagascarBrowser.Shell.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="{DynamicResource ViewPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Téléchargements" Style="{StaticResource ViewTitle}"/>
                <TextBlock Text="Fichiers en cours et terminés" Style="{StaticResource ViewSubtitle}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Actualiser" Style="{StaticResource SecondaryButton}"
                    Click="Refresh_Click" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <ListBox x:Name="DownloadsList" Style="{StaticResource DarkListBox}"
                     ItemContainerStyle="{StaticResource DarkListItem}"
                     SelectionChanged="DownloadsList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,0,0,1" Padding="4,9">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding FileName}" FontSize="12.5"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           ToolTip="{Binding Path}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding State}" FontSize="11"
                                           Foreground="{DynamicResource MutedBrush}" Margin="14,0,0,0"
                                           VerticalAlignment="Center"/>
                                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Height="4" Margin="0,8,0,0"
                                             Style="{StaticResource DarkProgressBar}"
                                             Maximum="100" Value="{Binding ProgressPercentage, Mode=OneWay}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                           Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Aucun téléchargement pour le moment." FontSize="13"
                           Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Barre d'actions -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Annuler" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" IsEnabled="False" Click="Cancel_Click"/>
                <Button x:Name="OpenButton" Content="Ouvrir le dossier" Style="{StaticResource PrimaryButton}"
                        IsEnabled="False" Click="Open_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
