<Window x:Class="MadagascarBrowser.Shell.ClearBrowsingDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Effacer les données de navigation"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        AutomationProperties.AutomationId="ClearDataWindow">
    <StackPanel Margin="24">
        <TextBlock Text="Effacer les données de navigation" Style="{StaticResource ViewTitle}"/>
        <TextBlock Text="Les données sélectionnées sont supprimées du profil local. Aucune donnée n'est envoyée sur Internet."
                   Style="{StaticResource ViewSubtitle}" Margin="0,6,0,18"/>

        <CheckBox x:Name="CookiesCheck" Content="Cookies et sessions"
                  Style="{StaticResource DarkCheckBox}" IsChecked="True" Margin="0,0,0,10"
                  AutomationProperties.AutomationId="ClearCookies"/>
        <CheckBox x:Name="CacheCheck" Content="Cache et fichiers temporaires"
                  Style="{StaticResource DarkCheckBox}" IsChecked="True" Margin="0,0,0,10"
                  AutomationProperties.AutomationId="ClearCache"/>
        <CheckBox x:Name="HistoryCheck" Content="Historique de navigation"
                  Style="{StaticResource DarkCheckBox}" IsChecked="True" Margin="0,0,0,10"
                  AutomationProperties.AutomationId="ClearHistory"/>
        <CheckBox x:Name="LocalStorageCheck" Content="Stockage local des sites"
                  Style="{StaticResource DarkCheckBox}" Margin="0,0,0,10"
                  AutomationProperties.AutomationId="ClearLocalStorage"/>
        <CheckBox x:Name="PasswordsCheck" Content="Mots de passe enregistrés (si l'autofill est activé)"
                  Style="{StaticResource DarkCheckBox}"
                  AutomationProperties.AutomationId="ClearPasswords"/>

        <TextBlock x:Name="FeedbackText" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                   Margin="0,14,0,0" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="ClearDataFeedback"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Annuler" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                    Click="Cancel_Click" AutomationProperties.AutomationId="ClearDataCancel"/>
            <Button x:Name="ClearButton" Content="Effacer" Style="{StaticResource PrimaryButton}"
                    Click="Clear_Click" AutomationProperties.AutomationId="ClearDataConfirm"/>
        </StackPanel>
    </StackPanel>
</Window>
