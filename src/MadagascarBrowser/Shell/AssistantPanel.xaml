<UserControl x:Class="MadagascarBrowser.Shell.AssistantPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="320" d:DesignWidth="360"
             Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- En-tête avec badge explicite -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="&#xE819;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="Assistance" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
            <Border Background="{DynamicResource WarnBrush}" CornerRadius="999"
                    Padding="6,2" Margin="8,0,0,0">
                <TextBlock Text="Optionnel" FontSize="9" Foreground="#FFFFFF" FontWeight="Bold"/>
            </Border>
        </StackPanel>

        <!-- Statut du service -->
        <Border Grid.Row="1" Background="{DynamicResource BgBrush}" CornerRadius="8"
                Padding="12,8" Margin="0,0,0,8" BorderBrush="{DynamicResource EdgeBrush}"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="État du service" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBlock FontSize="12" Foreground="{DynamicResource TextBrush}"
                           TextWrapping="Wrap"
                           Text="{Binding StatusMessage}"/>
            </StackPanel>
        </Border>

        <!-- Message explicite : aucune transmission automatique -->
        <TextBlock Grid.Row="2" FontSize="10.5" Foreground="{DynamicResource MutedBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,8">
            <Run Text="Le navigateur ne transmet jamais le contenu complet des pages, l'historique, les cookies ou les mots de passe vers un service externe sans confirmation explicite de l'utilisateur." FontStyle="Italic"/>
        </TextBlock>

        <!-- Actions d'assistance disponibles -->
        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Text="Actions disponibles" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
            <WrapPanel Orientation="Horizontal">
                <Button Content="Résumer la page" Style="{StaticResource SecondaryButton}"
                        Click="Summarize_Click" ToolTip="Sur demande explicite uniquement"
                        Margin="0,0,6,6" Padding="10,5" FontSize="11"/>
                <Button Content="Expliquer" Style="{StaticResource SecondaryButton}"
                        Click="Explain_Click" Margin="0,0,6,6" Padding="10,5" FontSize="11"/>
                <Button Content="Rechercher" Style="{StaticResource SecondaryButton}"
                        Click="SearchInPage_Click" Margin="0,0,6,6" Padding="10,5" FontSize="11"/>
                <Button Content="Synthétiser" Style="{StaticResource SecondaryButton}"
                        Click="Synthesize_Click" Margin="0,0,6,6" Padding="10,5" FontSize="11"/>
            </WrapPanel>
        </StackPanel>

        <!-- Résultat ou message d'information -->
        <Border Grid.Row="4" Background="{DynamicResource SurfaceHighBrush}" CornerRadius="8"
                BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" Padding="12"
                MinHeight="80">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ResultText" FontSize="12" Foreground="{DynamicResource TextBrush}"
                           TextWrapping="Wrap"
                           Text="Aucun service d'assistance configuré. Pour activer cette capacité, configurez un service dans les paramètres. Aucune donnée n'a été transmise automatiquement."/>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
