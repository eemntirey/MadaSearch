<Window x:Class="MadagascarBrowser.Shell.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="À propos" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        AutomationProperties.AutomationId="AboutWindow">
    <StackPanel Margin="24">
        <TextBlock Text="Madagascar Browser" Style="{StaticResource ViewTitle}"/>
        <TextBlock Text="Navigateur local-first : DataSaver mesuré, bloqueur de publicités natif, zéro compte."
                   Style="{StaticResource ViewSubtitle}" Margin="0,6,0,18"/>

        <Border Background="{DynamicResource SurfaceHighBrush}" BorderBrush="{DynamicResource EdgeBrush}"
                BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="14">
            <StackPanel>
                <TextBlock Text="Application" Style="{StaticResource SectionLabel}"/>
                <TextBlock x:Name="AppVersionText" FontSize="12.5" Margin="0,4,0,14"
                           AutomationProperties.AutomationId="AppVersion"/>

                <TextBlock Text="Moteur (hérité de Microsoft WebView2)" Style="{StaticResource SectionLabel}"/>
                <TextBlock x:Name="WebViewVersionText" FontSize="12.5" Margin="0,4,0,2"
                           AutomationProperties.AutomationId="WebViewVersion"/>
                <TextBlock x:Name="RuntimeStatusText" FontSize="12.5"
                           Foreground="{DynamicResource MutedBrush}"
                           AutomationProperties.AutomationId="WebViewRuntimeStatus"/>
            </StackPanel>
        </Border>

        <TextBlock Text="Le moteur (TLS, réseau, JavaScript, CSS) n'est pas réimplémenté : il est fourni par Microsoft et mis à jour avec lui. L'application signale son état, elle ne le remplace pas."
                   Style="{StaticResource ViewSubtitle}" Margin="0,14,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Fermer" Style="{StaticResource PrimaryButton}" Click="Close_Click"
                    AutomationProperties.AutomationId="AboutClose"/>
        </StackPanel>
    </StackPanel>
</Window>
