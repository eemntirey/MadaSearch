<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Surfaces (thème clair) ============ -->
    <SolidColorBrush x:Key="BgBrush" Color="#F5F3F0"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceHighBrush" Color="#FAF9F7"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#EDEAE5"/>
    <SolidColorBrush x:Key="ActiveTabBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PillBrush" Color="#D8D4CD"/>

    <!-- ============ Filets (thème clair) ============ -->
    <SolidColorBrush x:Key="EdgeBrush" Color="#C9C4BC"/>
    <SolidColorBrush x:Key="EdgeStrongBrush" Color="#B8B2A8"/>

    <!-- ============ Texte (thème clair) ============ -->
    <SolidColorBrush x:Key="TextBrush" Color="#1C1B18"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#6E6960"/>
    <SolidColorBrush x:Key="FaintBrush" Color="#9C968C"/>

    <!-- ============ Sémantique (inchangé) ============ -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF4438"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#33201E"/>
    <SolidColorBrush x:Key="SecureBrush" Color="#19B36B"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#F0A63C"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF5C57"/>

    <!-- ============ Texte et survol sur accent ============ -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#E81123"/>

    <!-- ============ Alias conservés ============ -->
    <SolidColorBrush x:Key="OkBrush" Color="#19B36B"/>

    <!-- ============ Drapeau malgache ============ -->
    <LinearGradientBrush x:Key="FlagMixBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#FC3D32" Offset="0.5"/>
        <GradientStop Color="#007E3A" Offset="1"/>
    </LinearGradientBrush>

    <!-- ============ Rayons ============ -->
    <CornerRadius x:Key="RadiusControl">6</CornerRadius>
    <CornerRadius x:Key="RadiusCard">10</CornerRadius>
    <CornerRadius x:Key="RadiusPill">14</CornerRadius>

    <!-- ============ Densité (mutée à l'exécution par ThemeManager) ============ -->
    <Thickness x:Key="ViewPadding">28,24,28,24</Thickness>
    <Thickness x:Key="CardPadding">20</Thickness>
    <Thickness x:Key="CardMargin">0,0,0,16</Thickness>

    <!-- ============ Mouvement ============ -->
    <Duration x:Key="MotionFast">0:0:0.12</Duration>
    <Duration x:Key="MotionMedium">0:0:0.18</Duration>
    <Duration x:Key="MotionSlow">0:0:0.22</Duration>
</ResourceDictionary>