<Window x:Class="MadagascarBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:chrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:shell="clr-namespace:MadagascarBrowser.Shell"
        mc:Ignorable="d"
        Title="Madagascar Browser" Height="800" Width="1200"
        Background="{DynamicResource BgBrush}">
    <Window.Style>
        <Style TargetType="{x:Type Window}">
            <Setter Property="chrome:WindowChrome.WindowChrome">
                <Setter.Value>
                    <chrome:WindowChrome CaptionHeight="34" CornerRadius="10" GlassFrameThickness="0"
                                         ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="WindowState" Value="Maximized">
                    <Setter Property="chrome:WindowChrome.WindowChrome">
                        <Setter.Value>
                            <chrome:WindowChrome CaptionHeight="34" CornerRadius="0" GlassFrameThickness="0"
                                                 ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Style>
    <Grid Background="{DynamicResource BgBrush}">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <!-- En maximisé, la fenêtre déborde de 8px de chaque côté (bord invisible
                         du WindowChrome) : on insette le contenu pour qu'il reste à l'écran. -->
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="Maximized">
                        <Setter Property="Margin" Value="8"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Bandeau tricolore : mélange des couleurs du drapeau malgache -->
        <Border Grid.Row="0" Height="3" Background="{DynamicResource FlagMixBrush}"/>

        <!-- Barre de titre personnalisée (WindowChrome) -->
        <Grid Grid.Row="1" Height="34" Background="{DynamicResource BgBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0"
                        VerticalAlignment="Center">
                <TextBlock Text="M" FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="adagascar Browser" FontFamily="Segoe UI" FontSize="11.5"
                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                           Margin="1,0,0,0"/>
            </StackPanel>

            <!-- IsHitTestVisibleInChrome sort les boutons de la zone "caption" du WindowChrome :
                 sans ça, la zone non-cliente avale le clic et les boutons ne sont pas cliquables. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                        chrome:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;"
                        chrome:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="Minimize_Click" ToolTip="Réduire" AutomationProperties.Name="Réduire"/>
                <Button Click="Maximize_Click" ToolTip="Agrandir"
                        chrome:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                            <Setter Property="Content" Value="&#xE922;"/>
                            <Setter Property="AutomationProperties.Name" Value="Agrandir"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                    <Setter Property="Content" Value="&#xE923;"/>
                                    <Setter Property="AutomationProperties.Name" Value="Restaurer"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;"
                        chrome:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CloseWindow_Click" ToolTip="Fermer" AutomationProperties.Name="Fermer la fenêtre"/>
            </StackPanel>
        </Grid>

        <!-- Barre d'onglets : onglets flottants sur le fond de la fenêtre -->
        <Border x:Name="TabStripBorder" Grid.Row="2" Background="{DynamicResource BgBrush}" BorderThickness="0">
            <Grid Margin="8,2,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ListBox Grid.Column="0"
                         ItemsSource="{Binding Tabs}"
                         SelectedItem="{Binding Active}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource TabStripItem}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Pastille d'onglet : le favicon n'est pas encore capturé par WebView2 -->
                                <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                                        Margin="0,0,8,0" VerticalAlignment="Center"
                                        Background="{DynamicResource AccentSoftBrush}"/>

                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5"
                                           VerticalAlignment="Center" MaxWidth="200"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Value="True"
                                                             Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Button Grid.Column="2" Style="{StaticResource IconButtonSmall}"
                                        Content="&#xE711;" Margin="6,0,0,0" VerticalAlignment="Center"
                                        Click="CloseTab_Click" ToolTip="Fermer l'onglet"
                                        AutomationProperties.Name="Fermer l'onglet"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Column="1" Style="{StaticResource IconButton}"
                        Content="&#xE710;" Margin="8,0,0,0" ToolTip="Nouvel onglet"
                        Click="NewTab_Click" AutomationProperties.Name="Nouvel onglet"/>
            </Grid>
        </Border>

        <!-- Contenu de l'onglet actif -->
        <ContentControl Grid.Row="3" Content="{Binding Active.View}"/>

        <!-- Barre d'état : état de navigation + puces d'information -->
        <Border x:Name="StatusBarBorder" Grid.Row="4" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,1,0,0">
            <Grid Height="26" Margin="12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource SecureBrush}"
                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="StatusText" FontSize="11" Foreground="{DynamicResource MutedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Prêt"/>
                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Active.IsLoading}" Value="True">
                                        <Setter Property="Text" Value="Chargement…"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource SurfaceHighBrush}" CornerRadius="999"
                            Padding="10,3" Margin="0,0,6,0">
                        <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                   Text="{Binding BlockedCount, Source={x:Static shell:BrowserStats.Instance}, StringFormat={}{0} pubs bloquées}"/>
                    </Border>
                    <Border Background="{DynamicResource SurfaceHighBrush}" CornerRadius="999"
                            Padding="10,3" Margin="0,0,6,0">
                        <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                   Text="{Binding SavedDataText, Source={x:Static shell:BrowserStats.Instance}}"
                                   ToolTip="{Binding SavedDataTooltip, Source={x:Static shell:BrowserStats.Instance}}"/>
                    </Border>
                    <Border Background="{DynamicResource SurfaceHighBrush}" CornerRadius="999" Padding="10,3">
                        <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                   Text="{Binding Tabs.Count, StringFormat={}{0} onglets}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
