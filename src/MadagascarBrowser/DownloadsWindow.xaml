<Window x:Class="MadagascarBrowser.DownloadsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Téléchargements" Width="760" Height="540"
        MinWidth="600" MinHeight="400" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <TextBlock Text="Téléchargements" FontSize="20" FontWeight="SemiBold"/>
            <Button DockPanel.Dock="Right" Content="Actualiser" Padding="10,5" Click="Refresh_Click"/>
        </DockPanel>
        <ListBox x:Name="DownloadsList" Grid.Row="1" ItemContainerStyle="{StaticResource DarkListItem}"
                 SelectionChanged="DownloadsList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Path}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding State}" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0"/>
                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Height="5" Margin="0,7,0,0"
                                     Maximum="100" Value="{Binding ProgressPercentage}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelButton" Content="Annuler" MinWidth="88" Padding="12,7"
                    Margin="0,0,8,0" IsEnabled="False" Click="Cancel_Click"/>
            <Button x:Name="OpenButton" Content="Ouvrir" MinWidth="88" Padding="12,7"
                    IsEnabled="False" Click="Open_Click"/>
        </StackPanel>
    </Grid>
</Window>